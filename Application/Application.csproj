	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Features\Languages\DTOs\" />
    <Folder Include="Features\Languages\Services\" />
    <Folder Include="Features\Languages\Validators\" />
